# All variables are optional. vscan auto-loads a local `.env` (gitignored)
# from the directory you run it in. Copy this file to `.env` and uncomment
# what you need. Explicit shell environment variables override the file.
#
# The LLM variables are only needed for the model used by `audit --explain`;
# without them an offline heuristic is used.

# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# Optional NVD API key (higher rate limits for CVSS enrichment).
# NVD_API_KEY=

# Override the vulnerability cache directory.
# VSCAN_CACHE_DIR=

# --- Server deployment (required by docker compose) ---
# Domain whose DNS A/AAAA record points at the server; Caddy gets the
# certificate for it automatically.
# DOMAIN=vscan.example.com
# Bearer token MCP clients must send; generate with: openssl rand -hex 32
# MCP_TOKEN=
